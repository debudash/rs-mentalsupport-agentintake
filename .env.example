# rs-assist configuration. Copy to .env (make setup does this) and fill in.
# Every variable the app reads is listed here. Never commit a real .env.

# development | test | production
APP_ENV=development

# --- Database -------------------------------------------------------------------------
# Local (supabase start):  postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Deployed: the Supabase *transaction pooler* URL (IPv4, port 6543), with +psycopg
# (the session pooler on :5432 runs out of clients under load, ISSUE-012; docs/DEPLOY.md):
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Inside docker compose, 127.0.0.1 is rewritten to host.docker.internal automatically.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Connections per server worker (pool + overflow). Defaults fit either Supabase Free pooler
# with 2 workers; raise them on a bigger plan.
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=1

# --- Supabase Auth --------------------------------------------------------------------
# Local values are printed by `npx supabase status` (make setup fills them in).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-side only: used to delete an Account at Withdrawal and to seed demo Accounts.
SUPABASE_SERVICE_ROLE_KEY=
# Leave empty to verify tokens with the project's JWKS (asymmetric signing keys).
# Set only if your project still signs tokens with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# --- LLM ------------------------------------------------------------------------------
# fake: no key needed; a keyword heuristic stands in for the model (the default).
# anthropic: Claude via the Anthropic API (what the deployed demo and benchmarks use).
# openai_compatible: OpenRouter by default (free models end in ":free"), or local Ollama
#   by setting LLM_BASE_URL=http://localhost:11434/v1. Free OpenRouter models may log
#   prompts: synthetic data only.
LLM_PROVIDER=fake
# anthropic: claude-opus-5-5 (default) or claude-haiku-5-5 (fastest)
#   The chat benchmark (p95 < 3 s) is met with claude-haiku-5-5 — set it to reproduce the
#   published numbers. Opus 5.5 alone takes ~3 s at p95, so with it the target is missed.
# openai_compatible: e.g. meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=claude-opus-5-5
# Anthropic effort: low | medium | high (low keeps chat under 3 s p95)
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=5
LLM_BASE_URL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Fake provider only: simulated latency for load tests (ms)
FAKE_LLM_DELAY_MS=0
# Development only (refused otherwise): log full prompts to ./llm_debug.log. Synthetic data only.
LLM_DEBUG_LOG=false

# --- OCR ------------------------------------------------------------------------------
# tesseract (installed in the Docker image) | fake
OCR_ENGINE=tesseract
OCR_CONFIDENCE_THRESHOLD=70
UPLOAD_MAX_BYTES=8388608

# --- Fault injection (demos and drills; refused when APP_ENV=production) ---------------
# Comma-separated: llm_timeout, llm_down, ocr_fail, db_slow. What each looks like:
# docs/RELIABILITY.md. One-off: FAULT_INJECT=llm_down make up
FAULT_INJECT=
FAULT_DB_DELAY_MS=1500

# --- Privacy --------------------------------------------------------------------------
# Encrypts Identity details, the Assessment's free-text reason, the Safety answer and the
# Intake conversation. Held only by the app server. make setup generates one; or run:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Serving --------------------------------------------------------------------------
FRONTEND_DIST=../frontend/dist
